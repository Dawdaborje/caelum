import { Theme } from "../theme.slint";

// Caelestia's OsIcon: the distro logo from /etc/os-release, recoloured tertiary,
// body.large * 1.2 (19px) square.
export component OsIcon {
    in property <image> logo;
    width: 19px;
    height: 19px;
    visible: root.logo.width > 0;
    Image {
        width: 100%;
        height: 100%;
        source: root.logo;
        colorize: Theme.tertiary;
        image-fit: contain;
    }
}
