// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme } from "../theme.slint";

export struct WorkspaceSlot {
    id: string,
    occupied: bool,
    active: bool,
}

// Caelestia's bar workspaces: a full-round surface-container pill with one slot
// per desktop, a primary pill sliding under the active one.
// shortcut: Caelestia morphs Material shapes (random shape on the active slot);
// this draws a circle (empty) or rounded square (occupied) until shapes land.
export component Workspaces {
    in property <[WorkspaceSlot]> slots;
    in property <bool> horizontal: true;
    in property <bool> active-indicator: true;
    in property <bool> occupied-bg: false;
    callback activate(string);

    // Caelestia: slot = bar inner width minus padding.small, spaced by spacing.small.
    property <length> slot: 32px;
    property <length> gap: 8px;
    property <length> pad: 4px;
    // Index of the active slot, or -1 when it is not shown.
    in property <int> active-index: -1;
    property <length> length: root.slots.length * root.slot + max(0, root.slots.length - 1) * root.gap + 2 * root.pad;
    width: root.horizontal ? root.length : root.slot + 2 * root.pad;
    height: root.horizontal ? root.slot + 2 * root.pad : root.length;

    Rectangle {
        background: Theme.surface-container;
        border-radius: min(self.width, self.height) / 2;
    }

    if root.active-indicator && root.active-index >= 0: Rectangle {
        property <length> offset: root.pad + root.active-index * (root.slot + root.gap);
        x: root.horizontal ? self.offset : root.pad;
        y: root.horizontal ? root.pad : self.offset;
        width: root.slot;
        height: root.slot;
        border-radius: root.slot / 2;
        background: Theme.primary;
        // Caelestia: EAnim (emphasized, 400ms); Slint has one bezier segment, so emphasized-decel.
        animate x, y { duration: 400ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    }

    for s[i] in root.slots: Rectangle {
        property <length> offset: root.pad + i * (root.slot + root.gap);
        x: root.horizontal ? self.offset : root.pad;
        y: root.horizontal ? root.pad : self.offset;
        width: root.slot;
        height: root.slot;
        border-radius: root.slot / 2;
        background: root.occupied-bg && s.occupied ? Theme.surface-container-highest : transparent;

        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: s.occupied ? 3px : 6px;
            background: s.active && root.active-indicator ? Theme.on-primary
                : s.occupied || s.active || root.occupied-bg ? Theme.on-surface
                : Theme.outline-variant;
        }
        TouchArea {
            clicked => { if !s.active { root.activate(s.id); } }
        }
    }
}
