// SPDX-License-Identifier: GPL-3.0-or-later
export enum Edge { top, bottom, left, right }

// Colours: every role of caelum_theme::Scheme (set by caelum-shell theme_bridge).
export global Theme {
    in property <color> background;
    in property <color> on-background;
    in property <color> surface;
    in property <color> surface-dim;
    in property <color> surface-bright;
    in property <color> surface-container-lowest;
    in property <color> surface-container-low;
    in property <color> surface-container;
    in property <color> surface-container-high;
    in property <color> surface-container-highest;
    in property <color> on-surface;
    in property <color> surface-variant;
    in property <color> on-surface-variant;
    in property <color> inverse-surface;
    in property <color> inverse-on-surface;
    in property <color> outline;
    in property <color> outline-variant;
    in property <color> shadow;
    in property <color> scrim;
    in property <color> surface-tint;
    in property <color> primary;
    in property <color> on-primary;
    in property <color> primary-container;
    in property <color> on-primary-container;
    in property <color> inverse-primary;
    in property <color> secondary;
    in property <color> on-secondary;
    in property <color> secondary-container;
    in property <color> on-secondary-container;
    in property <color> tertiary;
    in property <color> on-tertiary;
    in property <color> tertiary-container;
    in property <color> on-tertiary-container;
    in property <color> error;
    in property <color> on-error;
    in property <color> error-container;
    in property <color> on-error-container;
    in property <color> primary-fixed;
    in property <color> primary-fixed-dim;
    in property <color> on-primary-fixed;
    in property <color> on-primary-fixed-variant;
    in property <color> secondary-fixed;
    in property <color> secondary-fixed-dim;
    in property <color> on-secondary-fixed;
    in property <color> on-secondary-fixed-variant;
    in property <color> tertiary-fixed;
    in property <color> tertiary-fixed-dim;
    in property <color> on-tertiary-fixed;
    in property <color> on-tertiary-fixed-variant;
    in property <length> border-thickness: 10px;
    in property <length> border-rounding: 25px;
    in property <Edge> bar-position: Edge.bottom;
    in property <length> bar-thickness: 60px;
}
